{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "buildCommand": "pnpm run build"
    },
    "broker-site": {
      "root": "artifacts/broker-site",
      "framework": "vite",
      "buildCommand": "PORT=3000 BASE_PATH=/ pnpm run build",
      "devCommand": "BASE_PATH=/ pnpm run dev",
      "outputDirectory": "dist/public"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "buildCommand": "PORT=3000 BASE_PATH=/ pnpm run build",
      "devCommand": "BASE_PATH=/ pnpm run dev",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api-server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "broker-site" }
    }
  ]
}
